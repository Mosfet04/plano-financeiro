# Banco (Neon / Vercel Postgres). Free tier basta.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# next-auth v5. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth Client (Google Cloud Console → Credentials → OAuth client ID → Web).
# Redirect URIs autorizados:
#   http://localhost:3000/api/auth/callback/google
#   https://<seu-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Quem pode entrar. Lista separada por vírgula — qualquer outro e-mail é rejeitado no login.
# Convidar alguém é acrescentar o e-mail aqui e publicar: no primeiro login a pessoa
# ganha um plano vazio automaticamente e preenche em /premissas.
# O PRIMEIRO e-mail da lista é o dono — é a conta que `npm run db:seed` carrega com
# os dados da planilha.
ALLOWED_EMAILS="mateusmr4@gmail.com,primo@gmail.com,irmao@gmail.com"

# Segredo da rota de atualização de taxas (/api/cron/market-rates).
# O Vercel Cron manda esse valor como "Authorization: Bearer <CRON_SECRET>".
# Gere com: openssl rand -hex 32
CRON_SECRET=""
